<idea-plugin>
    <id>com.github.runit</id>
    <name>RunIt</name>
    <version>1.0.0</version>
    <vendor email="runit@example.com" url="https://github.com/runit">RunIt</vendor>

    <description><![CDATA[
        <p>RunIt - One-click script runner for JetBrains IDEs.</p>
        <p>Easily configure and run custom scripts directly from the IDE toolbar.</p>
    ]]></description>

    <change-notes><![CDATA[
        <p>1.0.0 - Initial release with TOML configuration, toolbar button, and command execution.</p>
    ]]></change-notes>

    <idea-version since-build="232"/>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="com.github.runit.config.RunItConfigService"/>
    </extensions>

    <actions>
        <action id="RunIt.ToolbarAction"
                class="com.github.runit.ui.RunItToolbarActionGroup"
                text="RunIt"
                description="RunIt script runner"
                icon="/icons/runIt.svg">
            <add-to-group group-id="MainToolbarRight" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
